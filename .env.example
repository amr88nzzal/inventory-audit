# نسخة للتوضيح فقط، لا أسرار هنا. انسخ إلى .env خارج Git.
# Example only, no secrets here. Copy to .env (never committed).
PORT=3000
NODE_ENV=development

# قاعدة البيانات (docker-compose.yml للتطوير). Database (docker-compose.yml for development).
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=inventory
POSTGRES_PORT=5433
DATABASE_URL=postgres://inventory:change-me-locally@127.0.0.1:5433/inventory

# اختياري: حساب بصلاحيات أعلى للتهجيرات فقط، ليعمل التطبيق بحساب أضعف.
# Optional: a more privileged account for migrations only, so the app can run with a weaker one.
# MIGRATION_DATABASE_URL=

# اختبارات التكامل: حساب يستطيع إنشاء قواعد بيانات مؤقتة.
# Integration tests: an account that can create temporary databases.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
