# نسخة للتوضيح فقط، لا أسرار هنا. انسخ إلى .env خارج Git.
# Example only, no secrets here. Copy to .env (never committed).
PORT=3000
NODE_ENV=development

# قاعدة البيانات (docker-compose.yml للتطوير). Database (docker-compose.yml for development).
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB=inventory
POSTGRES_PORT=5433
DATABASE_URL=postgres://inventory:change-me-locally@127.0.0.1:5433/inventory

# سر توقيع التوكن: عشوائي وطوله 32 حرفاً على الأقل، ويُرفض في الإنتاج إن بدا كقيمة مثال.
# ولّده بـ: openssl rand -base64 48
# Token signing secret: random, at least 32 characters; rejected in production if it looks like a placeholder.
# Generate with: openssl rand -base64 48
JWT_SECRET=

# مفتاح تشفير الحقول الحساسة (سر TOTP). 32 بايت بصيغة base64، ويُحفظ منفصلاً عن النسخ الاحتياطية.
# ولّده بـ: echo "k1:$(openssl rand -base64 32)"  ثم ENCRYPTION_KEY_ID=k1
# لتدوير المفتاح: أضف k2 بجانب k1 (مفصولين بفاصلة) وغيّر ENCRYPTION_KEY_ID؛ احتفظ بـ k1 لفك المشفّر القديم.
# Key for encrypting sensitive fields (the TOTP secret). 32 bytes, base64; keep it apart from backups.
# To rotate: add k2 next to k1 (comma-separated) and change ENCRYPTION_KEY_ID; keep k1 to decrypt old data.
ENCRYPTION_KEYS=
ENCRYPTION_KEY_ID=k1

# مدير المنصة (مدير المشروع). الخيار 2 (للإنتاج): ضع الاثنين لإنشاء أول مدير عند الإقلاع إن لم يوجد أحد،
# ثم **احذفهما** بعد أول دخول. كلمة المرور مؤقتة (12 حرفاً فأكثر) وتُغيَّر عند ربط تطبيق المصادقة.
# Option 2 (production): set both to create the first platform admin at boot when none exists, then
# REMOVE them after the first sign-in. The password is temporary (12+ chars), changed at authenticator enrollment.
# PLATFORM_ADMIN_USERNAME=
# PLATFORM_ADMIN_PASSWORD=
# الخيار 1 (CLI على الخادم): PLATFORM_CLI_PASSWORD=... docker compose exec api node dist/cli.js create-platform-admin <name>
# Option 1 (CLI on the server): see above. reset-platform-admin <name> replaces a lost device or password.

# اختياري: عناوين IP مسموحة لمنطقة /platform (غيرها يرى 404)، ومدة توكن المنصة بالدقائق.
# Optional: IP allowlist for /platform (others see 404) and the platform token lifetime in minutes.
# PLATFORM_ALLOWED_IPS=
# PLATFORM_TOKEN_TTL_MINUTES=30

# الجلسات: توكن التحديث يتجدد بكل استعمال (أيام)، والجلسة لها عمر مطلق لا تتجاوزه (أيام).
# Sessions: the refresh token renews on each use (days); the session has an absolute lifetime (days).
# REFRESH_TOKEN_TTL_DAYS=30
# SESSION_MAX_DAYS=90

# اختياري: حساب بصلاحيات أعلى للتهجيرات فقط، ليعمل التطبيق بحساب أضعف.
# Optional: a more privileged account for migrations only, so the app can run with a weaker one.
# MIGRATION_DATABASE_URL=

# اختبارات التكامل: حساب يستطيع إنشاء قواعد بيانات مؤقتة.
# Integration tests: an account that can create temporary databases.
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# ───── الإنتاج (infra/docker-compose.yml) / Production (infra/docker-compose.yml) ─────
# POSTGRES_USER/PASSWORD/DB أعلاه تصبح حساب المالك لـ migrate؛ التطبيق يتصل بـ inventory_login بدلاً منه.
# POSTGRES_USER/PASSWORD/DB above become the owner account used by migrate; the app connects as inventory_login instead.
# كلمة مرور حساب دخول التطبيق (16 حرفاً فأكثر). ولّدها بـ: openssl rand -hex 24
# The app login account password (16+ chars). Generate with: openssl rand -hex 24
# APP_DB_PASSWORD=
# GATEWAY_PORT=8080
# اختياري، النسخ الاحتياطي (profile backup): Optional, backups (profile backup):
# BACKUP_PASSPHRASE_FILE=/etc/inventory/backup.passphrase
# BACKUP_REMOTE=b2:inventory-backups
# RCLONE_CONFIG_DIR=/etc/inventory/rclone
# BACKUP_HOUR_UTC=02

