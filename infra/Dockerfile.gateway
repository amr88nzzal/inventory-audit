# البناء من جذر المستودع: docker build -f infra/Dockerfile.gateway .
# Build from the repo root: docker build -f infra/Dockerfile.gateway .
#
# مرحلة أولى تبني الواجهة (Vite) ومرحلة ثانية تقدّمها nginx مع تمرير /api إلى الخادم.
# The first stage builds the web app (Vite); the second serves it with nginx and proxies /api to the server.
ARG NODE_IMAGE=public.ecr.aws/docker/library/node:22-slim
ARG NGINX_IMAGE=public.ecr.aws/docker/library/nginx:alpine

FROM ${NODE_IMAGE} AS web
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/mobile/package.json apps/mobile/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
RUN pnpm install --frozen-lockfile --filter @inventory/web...
COPY apps/web apps/web
COPY packages/shared packages/shared
RUN pnpm --filter @inventory/web build

FROM ${NGINX_IMAGE}
COPY infra/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY infra/nginx/security-headers.conf /etc/nginx/snippets/security-headers.conf
COPY infra/nginx/web-headers.conf /etc/nginx/snippets/web-headers.conf
COPY --from=web /app/apps/web/dist /usr/share/nginx/html
EXPOSE 80
